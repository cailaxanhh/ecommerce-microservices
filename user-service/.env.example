# ─── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── PostgreSQL ────────────────────────────────────────────
# Matches docker-compose.yml (postgres / postgres, database created by db/init-multiple-dbs.sh)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=user_service

# ─── Internal JWT (issued by the API gateway → downstream services) ──
# Must match the INTERNAL_JWT_SECRET in api-gateway/.env
INTERNAL_JWT_SECRET=HYUIhU6iufn6o4dSZx0YOyJLWjV9QUnPQfacfnp4K5Y

# ─── User tokens (issued by this service for login/register/renew-token) ──
# Secret used to sign/verify end-user access & refresh tokens.
# Must match JWT_SECRET in api-gateway/.env so the gateway accepts them.
# Falls back to INTERNAL_JWT_SECRET when not set.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info