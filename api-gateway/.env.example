# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Client JWT Authentication ─────────────────────────────
# Path to the PEM public key file used to verify client tokens
# (RS256).  Alternatively set JWT_SECRET for HS256 symmetric mode.
JWT_PUBLIC_KEY=
JWT_SECRET=EgXF79HxcerkRGKrcXCieSQjVNTGXNtrF2BMzkUmIvn

# ─── Internal JWT (issued by gateway → downstream services) ──
INTERNAL_JWT_SECRET=HYUIhU6iufn6o4dSZx0YOyJLWjV9QUnPQfacfnp4K5Y
INTERNAL_JWT_EXPIRES_IN=300s

# ─── Downstream service URLs ───────────────────────────────
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# ─── Redis (rate-limiting) ──────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── Throttler ──────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
